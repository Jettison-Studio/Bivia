{
  "expo": {
    "name": "Bivia",
    "slug": "bivia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bivia.mobile"
    },
    "android": {
      "package": "app.bivia.mobile",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Bivia",
      "shortName": "Bivia"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite"
    ],
    "scheme": "bivia"
  }
}
